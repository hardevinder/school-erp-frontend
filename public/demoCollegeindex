<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <!-- ======================================================
         FAVICON
    ======================================================= -->
    <link
      rel="icon"
      href="%PUBLIC_URL%/images/DemoLogo.png"
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#0d315f"
    />

    <!-- ======================================================
         PRIMARY SEO
    ======================================================= -->
    <meta
      name="description"
      content="EduBridge Demo College ERP & LMS Portal – a smart digital platform for academics, students, faculty, examinations, fees, attendance, administration and campus management."
