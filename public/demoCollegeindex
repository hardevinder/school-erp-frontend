    <meta
      name="author"
      content="EduBridge ERP & LMS"
    />

    <!-- ======================================================
         PAGE TITLE
    ======================================================= -->
    <title>
      EduBridge Demo College | ERP & LMS Portal
    </title>

    <!-- ======================================================
         CANONICAL URL
    ======================================================= -->
    <link
      rel="canonical"
      href="https://demo-college.edubridgeerp.in/"
    />

    <!-- ======================================================
         APPLE / PWA
    ======================================================= -->
    <link
      rel="apple-touch-icon"
      href="%PUBLIC_URL%/images/DemoLogo.png"
    />

    <link
      rel="manifest"
      href="%PUBLIC_URL%/manifest.json"
    />

    <!-- ======================================================
         OPEN GRAPH
    ======================================================= -->
    <meta
      property="og:title"
      content="EduBridge Demo College | ERP & LMS Portal"
    />

    <meta
      property="og:description"
      content="Experience a smart connected college ecosystem for academics, administration, examinations, students, faculty, fees and campus operations with EduBridge ERP & LMS."
    />

    <meta
      property="og:image"
      content="https://demo-college.edubridgeerp.in/images/DemoCollege.png"
    />

    <meta
      property="og:url"
      content="https://demo-college.edubridgeerp.in/"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="EduBridge Demo College"
    />

    <!-- ======================================================
         TWITTER / SOCIAL CARD
    ======================================================= -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content="EduBridge Demo College | ERP & LMS Portal"
    />

    <meta
      name="twitter:description"
      content="A modern College ERP & LMS for academics, students, faculty, examinations, fees, attendance and administration."
    />

    <meta
      name="twitter:image"
      content="https://demo-college.edubridgeerp.in/images/DemoCollege.png"
    />

    <!-- ======================================================
         FAVICONS
    ======================================================= -->
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="%PUBLIC_URL%/images/DemoLogo.png"
    />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="%PUBLIC_URL%/images/DemoLogo.png"
    />

    <!-- ======================================================
         PERFORMANCE / FONTS
    ======================================================= -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
