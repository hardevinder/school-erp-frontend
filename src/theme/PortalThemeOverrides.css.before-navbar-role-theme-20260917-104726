}
html body .classic-dashboard-theme .quick-link-section {
  background: color-mix(in srgb, var(--edb-dashboard-bg) 78%, var(--edb-surface) 22%) !important;
  border-color: var(--edb-border) !important;
}
html body .classic-dashboard-theme .quick-section-icon,
html body .classic-dashboard-theme .link-card-ex .icon-wrap {
