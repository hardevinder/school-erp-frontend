  --premium-gold: var(--edb-accent) !important;
  --premium-ivory: var(--edb-dashboard-bg) !important;
  --premium-paper: var(--edb-surface) !important;
  --premium-border: var(--edb-border) !important;
  --premium-text: var(--edb-text) !important;
  --premium-muted: var(--edb-muted) !important;
