/* PORTAL_THEME_OVERRIDE_V2
   Dynamic shell/dashboard bridge.
   This file intentionally loads last and overrides the older Burgundy/Gold V3/V5 visual layers.
*/

:root {
  /* Saved fallback values. Runtime overwrites these from Schools.theme_config. */
  --edb-saved-primary: #66131b;
  --edb-saved-primary-dark: #470a11;
  --edb-saved-accent: #c49a45;
  --edb-saved-sidebar-bg: #fcf8f2;
  --edb-saved-navbar-bg: #fffdf9;
  --edb-saved-navbar-title: #66131b;
  --edb-saved-navbar-subtitle: #c49a45;
  --edb-saved-dashboard-bg: #f6f3ee;
  --edb-saved-surface: #fffdfa;
  --edb-saved-text: #261f1d;

  /* Live-preview aliases first; saved institution values are the fallback. */
  --edb-primary: var(--portal-primary, var(--theme-primary, var(--app-primary, var(--brand-primary, var(--edb-saved-primary)))));
  --edb-primary-dark: var(--portal-primary-dark, var(--theme-primary-dark, var(--app-primary-dark, var(--brand-primary-dark, var(--edb-saved-primary-dark)))));
  --edb-accent: var(--portal-accent, var(--theme-accent, var(--app-accent, var(--brand-accent, var(--edb-saved-accent)))));
  --edb-sidebar-bg: var(--portal-sidebar-bg, var(--theme-sidebar-bg, var(--app-sidebar-bg, var(--edb-saved-sidebar-bg))));
  --edb-navbar-bg: var(--portal-navbar-bg, var(--theme-navbar-bg, var(--app-navbar-bg, var(--edb-saved-navbar-bg))));
  --edb-navbar-title: var(--portal-navbar-title, var(--theme-navbar-title, var(--app-navbar-title, var(--edb-saved-navbar-title))));
  --edb-navbar-subtitle: var(--portal-navbar-subtitle, var(--theme-navbar-subtitle, var(--app-navbar-subtitle, var(--edb-saved-navbar-subtitle))));
  --edb-dashboard-bg: var(--portal-dashboard-bg, var(--theme-dashboard-bg, var(--app-dashboard-bg, var(--edb-saved-dashboard-bg))));
  --edb-surface: var(--portal-surface, var(--theme-surface, var(--app-surface, var(--edb-saved-surface))));
  --edb-text: var(--portal-text, var(--portal-text-color, var(--theme-text, var(--app-text, var(--edb-saved-text)))));

  --edb-primary-soft: color-mix(in srgb, var(--edb-primary) 10%, white);
  --edb-primary-soft-2: color-mix(in srgb, var(--edb-primary) 5%, white);
  --edb-accent-soft: color-mix(in srgb, var(--edb-accent) 16%, white);
  --edb-border: color-mix(in srgb, var(--edb-text) 14%, transparent);
  --edb-muted: color-mix(in srgb, var(--edb-text) 62%, white);
  --edb-faint: color-mix(in srgb, var(--edb-text) 42%, white);
  --edb-shell-shadow: color-mix(in srgb, var(--edb-primary-dark) 11%, transparent);

  /* Existing premium CSS already uses these names. Redirect them to the dynamic palette. */
  --portal-burgundy: var(--edb-primary);
  --portal-burgundy-dark: var(--edb-primary-dark);
  --portal-burgundy-soft: color-mix(in srgb, var(--edb-primary) 82%, white);
  --portal-gold: var(--edb-accent);
  --portal-gold-soft: color-mix(in srgb, var(--edb-accent) 58%, white);
  --portal-ivory: var(--edb-dashboard-bg);
  --portal-paper: var(--edb-surface);
  --portal-border: var(--edb-border);
  --portal-ink: var(--edb-text);
  --portal-muted: var(--edb-muted);
}

/* ===== Main shell ===== */
html body .app-content {
  background-color: var(--edb-dashboard-bg);
  color: var(--edb-text);
}

/* ===== Sidebar: defeat the old V3/V5 hard-coded warm palette ===== */
html body .app-sidebar {
  --sidebar-text: var(--edb-text);
  --sidebar-muted: var(--edb-muted);
  --sidebar-border: var(--edb-border);
  --sidebar-hover: var(--edb-primary-soft-2);
  --sidebar-active: linear-gradient(135deg, var(--edb-primary-soft) 0%, var(--edb-surface) 100%);
  --sidebar-shadow: 8px 0 28px var(--edb-shell-shadow);
  --sidebar-shadow-soft: 0 5px 14px var(--edb-shell-shadow);

  background: linear-gradient(
    180deg,
    var(--edb-sidebar-bg) 0%,
    color-mix(in srgb, var(--edb-sidebar-bg) 96%, var(--edb-primary) 4%) 100%
  ) !important;
  border-right-color: var(--edb-border) !important;
  box-shadow: var(--sidebar-shadow) !important;
  color: var(--edb-text) !important;
}

html body .app-sidebar .sidebar-top {
  background: color-mix(in srgb, var(--edb-sidebar-bg) 96%, transparent) !important;
  border-bottom-color: var(--edb-border) !important;
}

html body .app-sidebar .toggle-btn {
  color: var(--edb-primary) !important;
  background: var(--edb-surface) !important;
  border-color: var(--edb-border) !important;
  box-shadow: 0 4px 12px var(--edb-shell-shadow) !important;
}
html body .app-sidebar .toggle-btn:hover {
  color: var(--edb-primary-dark) !important;
  background: var(--edb-primary-soft-2) !important;
  border-color: color-mix(in srgb, var(--edb-primary) 35%, var(--edb-border)) !important;
}

html body .app-sidebar .sidebar-search {
  border-color: var(--edb-border) !important;
  background: color-mix(in srgb, var(--edb-surface) 92%, var(--edb-primary) 8%) !important;
  color: var(--edb-muted) !important;
}
html body .app-sidebar .sidebar-search:focus-within {
  border-color: color-mix(in srgb, var(--edb-primary) 55%, white) !important;
  background: var(--edb-surface) !important;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--edb-primary) 12%, transparent) !important;
}
html body .app-sidebar .sidebar-search input {
  color: var(--edb-text) !important;
}
html body .app-sidebar .sidebar-search input::placeholder {
  color: var(--edb-faint) !important;
}
html body .app-sidebar .sidebar-search-clear,
html body .app-sidebar .sidebar-category-arrow {
  color: var(--edb-muted) !important;
}
html body .app-sidebar .sidebar-search-clear:hover {
  background: var(--edb-primary-soft) !important;
  color: var(--edb-primary-dark) !important;
}

html body .app-sidebar .sidebar-category {
  color: var(--edb-text) !important;
  border-color: transparent !important;
}
html body .app-sidebar .sidebar-category:hover {
  background: var(--edb-primary-soft-2) !important;
  color: var(--edb-primary-dark) !important;
}
html body .app-sidebar .sidebar-category.selected {
  color: var(--edb-primary-dark) !important;
  background: linear-gradient(135deg, var(--edb-primary-soft) 0%, var(--edb-surface) 100%) !important;
  border-color: color-mix(in srgb, var(--edb-primary) 25%, var(--edb-border)) !important;
  box-shadow: 0 5px 14px var(--edb-shell-shadow) !important;
}
html body .app-sidebar .sidebar-category.route-active::before {
  background: linear-gradient(180deg, var(--edb-accent), var(--edb-primary)) !important;
}
html body .app-sidebar .sidebar-category-icon,
html body .app-sidebar .sidebar-category[style] .sidebar-category-icon,
html body .app-sidebar .sidebar-category.selected .sidebar-category-icon {
  background-color: var(--edb-primary) !important;
  background-image: linear-gradient(145deg, var(--edb-primary) 0%, var(--edb-primary-dark) 100%) !important;
  color: white !important;
  border-color: color-mix(in srgb, var(--edb-accent) 55%, transparent) !important;
  box-shadow: 0 5px 12px var(--edb-shell-shadow) !important;
}
html body .app-sidebar .sidebar-category-label,
html body.sb-collapsed .app-sidebar .sidebar-category-label {
  color: var(--edb-text) !important;
  opacity: 1 !important;
}
html body .app-sidebar .sidebar-category.selected .sidebar-category-label,
html body.sb-collapsed .app-sidebar .sidebar-category.selected .sidebar-category-label {
  color: var(--edb-primary-dark) !important;
  opacity: 1 !important;
}
html body .app-sidebar .sidebar-category-count {
  background: var(--edb-primary-soft) !important;
  color: var(--edb-primary-dark) !important;
}
html body .app-sidebar .sidebar-category.selected .sidebar-category-count {
  background: var(--edb-accent-soft) !important;
  color: color-mix(in srgb, var(--edb-accent) 58%, black) !important;
}
html body .app-sidebar .sidebar-category-direct {
  background: var(--edb-accent-soft) !important;
  color: color-mix(in srgb, var(--edb-accent) 58%, black) !important;
}
html body .app-sidebar .sidebar-dashboard-link {
  background: color-mix(in srgb, var(--edb-surface) 92%, transparent) !important;
  border-color: var(--edb-border) !important;
}
html body .app-sidebar .sidebar-dashboard-link::after {
  background: var(--edb-border) !important;
}
html body .app-sidebar::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--edb-primary) 22%, transparent) !important;
  border-color: transparent !important;
}
html body .app-sidebar::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--edb-primary) 35%, transparent) !important;
}

/* LMS-first direct navigation */
html body .app-sidebar .sidebar-lms-direct-head {
  color: var(--edb-primary-dark) !important;
}
html body .app-sidebar .sidebar-lms-direct-head > span i,
html body .app-sidebar .sidebar-lms-direct-group-title span:last-child {
  color: var(--edb-accent) !important;
}
html body .app-sidebar .sidebar-lms-direct-head small,
html body .app-sidebar .sidebar-lms-direct-current {
  border-color: color-mix(in srgb, var(--edb-accent) 35%, var(--edb-border)) !important;
  background: var(--edb-accent-soft) !important;
  color: color-mix(in srgb, var(--edb-accent) 58%, black) !important;
}
html body .app-sidebar .sidebar-lms-direct-group {
  border-top-color: var(--edb-border) !important;
}
html body .app-sidebar .sidebar-lms-direct-group-title {
  color: var(--edb-muted) !important;
}
html body .app-sidebar .sidebar-lms-direct-item {
  color: var(--edb-text) !important;
}
html body .app-sidebar .sidebar-lms-direct-item:hover {
  background: var(--edb-primary-soft-2) !important;
  border-color: var(--edb-border) !important;
  color: var(--edb-primary-dark) !important;
}
html body .app-sidebar .sidebar-lms-direct-item.active {
  background: linear-gradient(90deg, var(--edb-primary-soft) 0%, var(--edb-surface) 100%) !important;
  border-color: color-mix(in srgb, var(--edb-primary) 25%, var(--edb-border)) !important;
  color: var(--edb-primary-dark) !important;
  box-shadow: 0 4px 12px var(--edb-shell-shadow) !important;
}
html body .app-sidebar .sidebar-lms-direct-item.active::before {
  background: linear-gradient(180deg, var(--edb-accent), var(--edb-primary)) !important;
}
html body .app-sidebar .sidebar-lms-direct-icon,
html body .app-sidebar .sidebar-lms-direct-item.active .sidebar-lms-direct-icon {
  border-color: var(--edb-border) !important;
  background: var(--edb-surface) !important;
  color: var(--edb-primary) !important;
}
html body .app-sidebar .sidebar-lms-direct-item.active .sidebar-lms-direct-icon {
  background: linear-gradient(145deg, var(--edb-primary), var(--edb-primary-dark)) !important;
  border-color: color-mix(in srgb, var(--edb-accent) 55%, transparent) !important;
  color: white !important;
}
html body .app-sidebar .sidebar-lms-direct-arrow {
  color: var(--edb-muted) !important;
}

/* Flyout / global-search panel */
html body .sidebar-submenu-panel,
html body .sidebar-mega-panel {
  background: var(--edb-surface) !important;
  border-color: var(--edb-border) !important;
  box-shadow: 12px 12px 34px var(--edb-shell-shadow) !important;
  color: var(--edb-text) !important;
}
html body .sidebar-submenu-header {
  border-color: var(--edb-border) !important;
  background: linear-gradient(145deg, var(--edb-primary-soft-2), var(--edb-surface) 72%) !important;
}
html body .sidebar-submenu-eyebrow {
  color: var(--edb-accent) !important;
}
html body .sidebar-submenu-header h2,
html body .sidebar-submenu-label {
  color: var(--edb-text) !important;
}
html body .sidebar-submenu-header p,
html body .sidebar-submenu-path,
html body .sidebar-submenu-empty,
html body .sidebar-submenu-arrow {
  color: var(--edb-muted) !important;
}
html body .sidebar-submenu-close,
html body .sidebar-submenu-search {
  background: var(--edb-surface) !important;
  border-color: var(--edb-border) !important;
  color: var(--edb-muted) !important;
}
html body .sidebar-submenu-search:focus-within {
  border-color: var(--edb-primary) !important;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--edb-primary) 12%, transparent) !important;
}
html body .sidebar-submenu-search input {
  color: var(--edb-text) !important;
}
html body .sidebar-submenu-item {
  color: var(--edb-text) !important;
}
html body .sidebar-submenu-item:hover {
  background: var(--edb-primary-soft-2) !important;
  border-color: var(--edb-border) !important;
}
html body .sidebar-submenu-item.active {
  background: var(--edb-primary-soft) !important;
  border-color: color-mix(in srgb, var(--edb-primary) 22%, var(--edb-border)) !important;
}
html body .sidebar-submenu-icon,
html body .sidebar-submenu-item.active .sidebar-submenu-icon {
  background: var(--edb-primary-soft-2) !important;
}
html body .sidebar-submenu-item:hover .sidebar-submenu-arrow {
  color: var(--edb-primary) !important;
}

/* ===== Mobile navigation ===== */
@media (max-width: 991.98px) {
  html body .bottom-nav,
  html body .bottom-nav-drawer {
    background: var(--edb-surface) !important;
    border-color: var(--edb-border) !important;
    color: var(--edb-text) !important;
  }
  html body .bottom-nav .bn-item,
  html body .bn-list-item {
    color: var(--edb-muted) !important;
  }
  html body .bottom-nav .bn-item.active,
  html body .bn-list-item.active {
    color: var(--edb-primary-dark) !important;
    background: var(--edb-primary-soft) !important;
  }
}

/* ===== Navbar ===== */
html body .college-navbar {
  background: var(--edb-navbar-bg) !important;
  border-bottom-color: var(--edb-border) !important;
  box-shadow: 0 8px 26px var(--edb-shell-shadow) !important;
}
html body .college-navbar .college-navbar__brand strong {
  color: var(--edb-navbar-title) !important;
}
html body .college-navbar .college-navbar__brand small {
  color: var(--edb-navbar-subtitle) !important;
}
html body .college-navbar .college-navbar__brand img {
  background: var(--edb-surface) !important;
  border-color: var(--edb-border) !important;
  box-shadow: 0 5px 15px var(--edb-shell-shadow) !important;
}
html body .college-navbar .college-role-select,
html body .college-navbar .branch-switcher .form-select,
html body .college-navbar .branch-switcher .input-group-text,
html body .college-navbar .college-navbar__bell,
html body .college-navbar .college-profile-button,
html body .college-navbar .college-quick-link > span {
  background: var(--edb-surface) !important;
  border-color: var(--edb-border) !important;
  color: var(--edb-text) !important;
}
html body .college-navbar .college-quick-link,
html body .college-navbar .college-quick-link small {
  color: var(--edb-muted) !important;
}
html body .college-navbar .college-quick-link:hover,
html body .college-navbar .college-quick-link:hover small,
html body .college-navbar .college-quick-link.active,
html body .college-navbar .college-quick-link.active small,
html body .college-navbar .college-navbar__bell,
html body .college-navbar .branch-switcher .input-group-text {
  color: var(--edb-primary) !important;
}
html body .college-navbar .college-quick-link:hover > span,
html body .college-navbar .college-profile-button:hover,
html body .college-navbar .college-navbar__bell:hover,
html body .college-navbar .college-profile-menu .dropdown-item:hover {
  background: var(--edb-primary-soft-2) !important;
  border-color: color-mix(in srgb, var(--edb-primary) 24%, var(--edb-border)) !important;
  color: var(--edb-primary-dark) !important;
}
html body .college-navbar .college-quick-link.active > span {
  background: linear-gradient(135deg, var(--edb-primary-dark), var(--edb-primary)) !important;
  color: white !important;
  border-color: var(--edb-primary) !important;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--edb-primary) 10%, transparent) !important;
}
html body .college-navbar .college-role-select:focus,
html body .college-navbar .branch-switcher .form-select:focus {
  border-color: var(--edb-primary) !important;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--edb-primary) 12%, transparent) !important;
}
html body .college-navbar .college-profile-menu {
  background: var(--edb-surface) !important;
  border-color: var(--edb-border) !important;
  box-shadow: 0 14px 40px var(--edb-shell-shadow) !important;
}

/* ===== ERP/LMS workspace switcher ===== */
html body .dashboard-workspaces {
  border-color: var(--edb-border) !important;
  background: color-mix(in srgb, var(--edb-dashboard-bg) 88%, var(--edb-primary) 12%) !important;
}
html body .dashboard-workspaces button {
