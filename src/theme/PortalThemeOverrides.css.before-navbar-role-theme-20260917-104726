}
html body .premium-portal {
  border-color: color-mix(in srgb, var(--edb-accent) 40%, transparent) !important;
  background: linear-gradient(118deg, var(--edb-primary-dark), var(--edb-primary) 58%, color-mix(in srgb, var(--edb-primary) 84%, white)) !important;
