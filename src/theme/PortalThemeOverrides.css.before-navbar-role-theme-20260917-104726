html body .lms-workspace .lms-hero h1,
html body .lms-workspace .lms-live-head h2,
html body .lms-workspace .lms-tools-head h2,
html body .lms-workspace .lms-live-stat strong,
html body .lms-workspace .lms-detail-copy strong,
html body .lms-workspace .lms-status-row b,
html body .lms-workspace .lms-action-content strong {
  color: var(--edb-primary-dark) !important;
}
html body .lms-workspace .lms-hero p,
html body .lms-workspace .lms-live-head p,
html body .lms-workspace .lms-tools-head p,
html body .lms-workspace .lms-live-stat span:last-child,
html body .lms-workspace .lms-detail-copy > span,
html body .lms-workspace .lms-action-content small {
  color: var(--edb-muted) !important;
