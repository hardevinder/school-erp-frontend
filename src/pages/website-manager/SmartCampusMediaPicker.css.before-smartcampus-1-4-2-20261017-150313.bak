.sc-media-box{border:1px solid #ebd9dc;background:#fffafa;border-radius:12px;padding:13px;margin:14px 0}.sc-media-box h4{margin:3px 0 5px}.sc-media-box p{font-size:12px;color:#756970}.sc-media-upload{display:inline-block!important;padding:10px 12px;background:#771422;color:white!important;border-radius:8px;cursor:pointer}.sc-media-upload input{display:none!important}.sc-media-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(125px,1fr));gap:8px;margin:12px 0}.sc-media-item,.sc-media-library{min-width:0;background:#fff;border:1px solid #e7d7da;border-radius:9px;padding:7px;text-align:left}.sc-media-item img,.sc-media-item video,.sc-media-library img,.sc-media-library video{width:100%;height:90px;object-fit:cover;border-radius:6px;background:#ece7e8}.sc-media-item span,.sc-media-library span{font-size:11px;display:block;overflow-wrap:anywhere}.sc-media-item button{border:1px solid #ddd;background:white;border-radius:4px;margin:3px 2px 0 0;cursor:pointer}.sc-media-help{font-size:11px!important}.sc-media-library{cursor:pointer}.sc-media-loading{font-size:10px}
