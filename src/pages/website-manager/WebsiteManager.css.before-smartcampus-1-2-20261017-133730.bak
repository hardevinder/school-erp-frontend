.scm{--sc-border:var(--edb-border,#e5e7eb);--sc-surface:var(--edb-surface,#fff);--sc-text:var(--edb-text,#182333);--sc-muted:var(--edb-muted-text,#657084);--sc-primary:var(--edb-primary,#72222a);color:var(--sc-text);padding:clamp(14px,2.3vw,28px);max-width:1620px;margin:auto;font-size:14px}.scm *{box-sizing:border-box}.scm button,.scm input,.scm select,.scm textarea{font:inherit}.scm button{cursor:pointer}.scm button:disabled{opacity:.55;cursor:not-allowed}.scm-hero{background:linear-gradient(115deg,var(--edb-primary-dark,#5d1923),var(--edb-primary,#823340));color:#fff;padding:28px 30px;border-radius:21px;display:flex;gap:20px;justify-content:space-between;align-items:center}.scm-kicker{font-size:11px;letter-spacing:.12em;font-weight:800;color:var(--sc-primary)}.scm-hero .scm-kicker{color:#ffdee0}.scm h1{font-weight:800;font-size:clamp(25px,2.6vw,36px);margin:7px 0}.scm h2{font-size:19px;font-weight:800;margin:4px 0}.scm h3{font-size:15px;font-weight:750}.scm p{margin:5px 0;line-height:1.5}.scm-hero p{color:#f5e8eb}.scm-hero-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.scm-internal{font-size:12px;background:#ffffff25;border:1px solid #ffffff4a;border-radius:999px;padding:8px 12px;white-space:nowrap}.scm-primary{border:0;background:var(--sc-primary);color:#fff;border-radius:11px;padding:11px 17px;font-weight:750}.scm-hero .scm-primary{background:#fff;color:#641e29}.scm-ghost{border:1px solid var(--sc-border);background:var(--sc-surface);color:var(--sc-text);padding:10px 14px;border-radius:10px;font-weight:650}.scm-info{margin:17px 0;background:var(--edb-primary-soft,#fdf2f3);border:1px solid var(--sc-border);border-left:4px solid var(--sc-primary);padding:12px 15px;border-radius:12px;line-height:1.5}.scm-alert{margin:12px 0;background:#fff1f2;color:#8c2330;border:1px solid #f4b6bf;padding:15px;border-radius:12px}.scm-alert button{border:0;border-radius:8px;padding:7px 12px;background:#8c2330;color:#fff;margin:8px 0}.scm-alert small{display:block}.scm-success{background:#edf9f2;border:1px solid #bde4cc;padding:12px 14px;margin:12px 0;border-radius:12px;color:#155d32}.scm-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin:18px 0}.scm-stat{border:1px solid var(--sc-border);background:var(--sc-surface);color:var(--sc-text);border-radius:16px;padding:19px;text-align:left;display:flex;gap:14px;align-items:center;box-shadow:0 4px 16px #17253b08}.scm-stat.is-active{outline:2px solid var(--sc-primary)}.scm-stat-icon{background:var(--edb-primary-soft,#faeff0);color:var(--sc-primary);width:43px;height:43px;border-radius:13px;display:grid;place-items:center;font-size:23px;flex-shrink:0}.scm-stat small{display:block;color:var(--sc-muted);font-size:12px;font-weight:600}.scm-stat strong{font-size:28px;line-height:1.35}.scm-layout{display:grid;grid-template-columns:236px minmax(0,1fr);gap:16px;align-items:start}.scm-nav,.scm-panel{background:var(--sc-surface);border:1px solid var(--sc-border);border-radius:18px;box-shadow:0 4px 16px #17253b06}.scm-nav{padding:12px;display:flex;flex-direction:column;gap:3px}.scm-nav-title{font-size:10px;color:var(--sc-muted);font-weight:800;letter-spacing:.12em;margin:13px 11px 6px}.scm-nav button{color:var(--sc-text);background:transparent;border:0;display:flex;gap:11px;align-items:center;width:100%;text-align:left;padding:11px;border-radius:10px;font-weight:650;font-size:13px}.scm-nav button span:nth-child(2){flex:1}.scm-nav button.selected{color:var(--sc-primary);background:var(--edb-primary-soft,#faeff0)}.scm-nav b{font-size:11px;color:var(--sc-muted)}.scm-nav-note{background:var(--edb-dashboard-bg,#f8f9fb);border-radius:11px;padding:12px;color:var(--sc-muted);font-size:11px;line-height:1.5;margin-top:12px}.scm-main{min-width:0}.scm-panel{padding:23px}.scm-panel-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;margin-bottom:20px}.scm-panel-head p{color:var(--sc-muted)}.scm-filters{display:flex;gap:10px;margin-bottom:18px}.scm-search{border:1px solid var(--sc-border);border-radius:11px;display:flex;align-items:center;gap:9px;padding:0 12px;flex:1;min-width:0}.scm-search span{font-size:22px;color:var(--sc-muted)}.scm-search input{border:0;outline:none;padding:12px 0;width:100%;background:transparent;color:var(--sc-text)}.scm select,.scm-form input,.scm-form textarea{background:var(--sc-surface);color:var(--sc-text);border:1px solid var(--sc-border);padding:11px 13px;border-radius:10px;min-width:0}.scm-table-scroll{overflow-x:auto}.scm-table{width:100%;border-collapse:collapse;min-width:760px}.scm-table th{text-transform:uppercase;letter-spacing:.04em;font-size:10px;color:var(--sc-muted);padding:12px;text-align:left;border-bottom:1px solid var(--sc-border)}.scm-table td{padding:15px 12px;border-bottom:1px solid var(--sc-border);vertical-align:middle}.scm-table td strong,.scm-table td small{display:block}.scm-table td small{color:var(--sc-muted);margin-top:4px}.scm-pill{display:inline-block;text-transform:capitalize;border-radius:999px;background:#f2f4f7;color:#475467;padding:5px 10px;font-size:11px;font-weight:750}.scm-pill.scm-published{background:#e8f7ee;color:#137448}.scm-pill.scm-review{background:#fff4d9;color:#8a5b00}.scm-pill.scm-draft{background:#edf1ff;color:#4059a9}.scm-row-actions{display:flex;flex-wrap:wrap;gap:5px}.scm-row-actions button{border:1px solid var(--sc-border);background:var(--sc-surface);color:var(--sc-primary);border-radius:8px;padding:7px 9px;font-size:11px;font-weight:700}.scm-row-actions .scm-positive{background:#e8f7ee;color:#137448}.scm-empty{padding:70px 15px;text-align:center;color:var(--sc-muted)}.scm-empty>span{font-size:42px}.scm-empty h3{color:var(--sc-text)}.scm-empty .scm-primary{margin-top:15px}.scm-form{display:grid;gap:19px;max-width:830px}.scm-form label{display:grid;gap:7px;font-weight:700}.scm-form textarea{resize:vertical;min-height:165px}.scm-form-actions{display:flex;justify-content:flex-end;gap:10px}.scm-overlay{position:fixed;inset:0;z-index:2100;background:#142036a8;display:flex;align-items:center;justify-content:center;padding:18px}.scm-modal{max-height:90vh;overflow:auto;width:min(850px,100%);border-radius:18px;background:var(--sc-surface);color:var(--sc-text);padding:26px}.scm-preview-content{white-space:pre-wrap;overflow-wrap:anywhere;border:1px solid var(--sc-border);border-radius:12px;padding:18px;background:var(--edb-dashboard-bg,#fafbfc);line-height:1.7;margin-bottom:18px}.scm-versions{display:grid;gap:7px}.scm-versions>div{display:flex;gap:12px;justify-content:space-between;padding:10px;border:1px solid var(--sc-border);border-radius:9px}.scm-versions small{color:var(--sc-muted)}.scm :focus-visible{outline:3px solid var(--sc-primary);outline-offset:2px}@media(max-width:1140px){.scm-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.scm-layout{grid-template-columns:195px minmax(0,1fr)}}@media(max-width:760px){.scm-hero{flex-direction:column;align-items:flex-start}.scm-layout{grid-template-columns:1fr}.scm-nav{flex-direction:row;overflow-x:auto;align-items:center}.scm-nav button{width:auto;white-space:nowrap}.scm-nav-title,.scm-nav-note{display:none}.scm-panel{padding:15px}.scm-filters{flex-direction:column}.scm-panel-head{flex-wrap:wrap}}@media(max-width:430px){.scm-stats{grid-template-columns:1fr 1fr;gap:8px}.scm-stat{padding:12px;gap:8px}.scm-stat-icon{width:32px;height:32px;font-size:18px}.scm-stat strong{font-size:21px}.scm-hero{padding:20px}.scm-hero-actions{width:100%}}
