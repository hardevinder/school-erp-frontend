import React,{useEffect,useState} from 'react';
import axios from 'axios';
const BASE=(process.env.REACT_APP_API_URL||axios.defaults.baseURL||'').replace(/\/$/,'');
export default function WebsiteManager(){
 const [rows,setRows]=useState([]),[title,setTitle]=useState(''),[content,setContent]=useState(''),[module,setModule]=useState('general'),[selected,setSelected]=useState(null),[versions,setVersions]=useState([]),[msg,setMsg]=useState('');
 const token=(localStorage.getItem('token')||sessionStorage.getItem('token'));const headers={Authorization:`Bearer ${token}`};
 const call=(method,path,data)=>axios({method,url:`${BASE}/api/smart-campus${path}`,data,headers});
 const load=()=>call('get','/publications').then(r=>setRows(r.data.items||[])).catch(e=>setMsg(e.response?.data?.message||e.message));
 useEffect(()=>{load();},[]);
 async function create(e){e.preventDefault();try{await call('post','/publications',{title,content,source_module:module,source_record_id:'manual'});setTitle('');setContent('');setMsg('Draft saved.');load();}catch(e){setMsg(e.response?.data?.message||e.message)}}
 async function status(p,s){try{await call('post',`/publications/${p.id}/status`,{status:s});setMsg(`Moved to ${s}.`);load()}catch(e){setMsg(e.response?.data?.message||e.message)}}
 async function preview(p){try{const r=await call('get',`/publications/${p.id}`);setSelected(r.data);const h=await call('get',`/publications/${p.id}/versions`);setVersions(h.data.items||[])}catch(e){setMsg(e.response?.data?.message||e.message)}}
 return <div style={{padding:24,maxWidth:1150,margin:'auto'}}><h2>Website Manager — Publishing Foundation</h2><p>Internal approval only. Nothing is exposed to public websites in Patch 1.</p><p role="status">{msg}</p><form onSubmit={create} style={{display:'grid',gap:10,maxWidth:700}}><h3>New website draft</h3><label>Source module <select value={module} onChange={e=>setModule(e.target.value)}>{['general','school','calendar','curriculum','events','achievements','faculty','transport','admissions'].map(x=><option key={x}>{x}</option>)}</select></label><label>Title <input required maxLength={240} value={title} onChange={e=>setTitle(e.target.value)} style={{width:'100%'}} /></label><label>Content <textarea value={content} onChange={e=>setContent(e.target.value)} rows={5} style={{width:'100%'}} /></label><button type="submit">Save draft</button></form><hr/><h3>Publication queue</h3><div style={{overflowX:'auto'}}><table style={{width:'100%',borderCollapse:'collapse'}}><thead><tr><th>Title</th><th>Module</th><th>Status</th><th>Version</th><th>Actions</th></tr></thead><tbody>{rows.map(p=><tr key={p.id}><td>{p.title}</td><td>{p.source_module}</td><td>{p.status}</td><td>{p.version}</td><td><button type="button" onClick={()=>preview(p)}>Preview</button>{(p.status==='draft')&&<button type="button" onClick={()=>status(p,'review')}>Send for review</button>}{p.status==='review'&&<><button type="button" onClick={()=>status(p,'draft')}>Return to draft</button><button type="button" onClick={()=>status(p,'published')}>Publish</button></>}{p.status==='published'&&<button type="button" onClick={()=>status(p,'archived')}>Archive</button>}</td></tr>)}</tbody></table></div>{selected&&<section style={{background:'var(--card-bg,#f8f9fa)',padding:16,marginTop:20}}><h3>{selected.title}</h3><p>Current status: {selected.status}</p><pre style={{whiteSpace:'pre-wrap',overflowWrap:'anywhere'}}>{selected.content}</pre><h4>Version history</h4>{versions.map(v=><p key={v.id}>v{v.version} — {v.action} — {new Date(v.createdAt).toLocaleString()}</p>)}<button type="button" onClick={()=>setSelected(null)}>Close preview</button></section>}</div>
}
