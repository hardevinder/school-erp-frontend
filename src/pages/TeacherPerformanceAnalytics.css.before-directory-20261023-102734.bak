.tpa-page{padding:26px;background:#f5f8fd;min-height:100vh;color:#142f56}.tpa-heading,.tpa-panel-head{display:flex;align-items:center;justify-content:space-between;gap:15px}.tpa-heading small{color:#1761bd;letter-spacing:1.2px;font-weight:800}.tpa-heading h1{font-size:28px;margin:7px 0}.tpa-heading p,.tpa-profile p,.tpa-note{color:#667c9e;font-size:13px}.tpa-actions{display:flex;gap:8px}.tpa-actions button,.tpa-filter button{border:1px solid #d7e3f1;background:#fff;color:#174674;border-radius:8px;padding:11px 14px;cursor:pointer;font-weight:700}.tpa-actions button:disabled{opacity:.45}.tpa-filter{display:grid;grid-template-columns:1fr 1.5fr 2fr auto;align-items:end;gap:14px;padding:18px;background:#fff;border:1px solid #dae5f3;border-radius:14px;margin:20px 0}.tpa-filter label{display:flex;flex-direction:column;font-size:12px;font-weight:700;gap:6px}.tpa-filter select,.tpa-panel-head input{background:#f9fbff;border:1px solid #cfdaeb;border-radius:8px;min-height:40px;padding:8px;max-width:100%;font-size:13px}.tpa-filter label small{color:#7790af}.tpa-filter .tpa-primary{background:#08467f;color:white}.tpa-alert,.tpa-note{padding:12px;border-radius:10px;margin:10px 0}.tpa-alert{background:#fff0f1;color:#ab3041}.tpa-note{background:#ebf2ff}.tpa-profile{display:flex;align-items:center;gap:18px;background:white;border:1px solid #dce6f4;border-radius:14px;padding:18px;margin-bottom:14px}.tpa-profile .tpa-avatar{width:85px;height:85px;font-size:30px}.tpa-profile h2{margin:0 0 4px}.tpa-profile small{color:#7587a0}.tpa-avatar{width:38px;height:38px;object-fit:cover;border-radius:50%;flex-shrink:0}.tpa-avatar-fallback{display:flex;align-items:center;justify-content:center;background:#e6effc;color:#135fba;font-weight:800}.tpa-stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:15px}.tpa-stats article{background:white;border:1px solid #dce6f4;border-radius:12px;padding:17px;min-width:0}.tpa-stats small{color:#5d7698;display:block}.tpa-stats strong{font-size:22px;display:block;margin-top:9px;word-break:break-word}.tpa-stats article:nth-child(4){background:#ebf9f2}.tpa-stats article:nth-child(6){background:#fff1f2}.tpa-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.tpa-panel{background:white;border:1px solid #dde7f4;border-radius:13px;padding:16px;margin-bottom:15px;min-width:0}.tpa-panel h2{font-size:16px;margin:0 0 16px}.tpa-chart-scroll,.tpa-scroll{overflow-x:auto}.tpa-chart-line{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e7edf5;padding:9px 5px;gap:15px}.tpa-chart-line>div:first-child{min-width:105px}.tpa-chart-line small{display:block;color:#7085a2}.tpa-bars{display:flex;gap:12px;justify-content:center;align-items:end;min-height:128px}.tpa-bar{min-width:58px;text-align:center;font-size:11px}.tpa-bar strong,.tpa-bar small{display:block}.tpa-track{height:90px;width:38px;margin:4px auto;display:flex;align-items:end;background:linear-gradient(#fff,#f4f8fd);border-bottom:1px solid #bdd0e5}.tpa-track>div{width:100%;border-radius:4px 4px 0 0}.tpa-scroll table{width:100%;border-collapse:collapse;font-size:12px;white-space:nowrap}.tpa-scroll th,.tpa-scroll td{padding:10px;border:1px solid #e0e8f3;text-align:left}.tpa-scroll th{background:#edf5ff}.tpa-scroll tr:nth-child(even){background:#f9fbff}.tpa-person{display:flex;align-items:center;gap:8px}.tpa-person small{display:block;color:#7990ab}.tpa-up{color:#0c9667}.tpa-down{color:#d33d49}.tpa-click{cursor:pointer}.tpa-click:hover{background:#eaf4ff!important}.tpa-empty{padding:75px 15px;text-align:center;color:#657e9a;border:1px dashed #bdd0e5;border-radius:14px;background:white}.tpa-backdrop{position:fixed;inset:0;background:#071b35aa;display:flex;align-items:center;justify-content:center;padding:20px;z-index:9999}.tpa-dialog{background:#fff;max-height:90vh;overflow:auto;width:min(1050px,100%);border-radius:16px;padding:24px}.tpa-dialog>button{float:right;padding:9px;border:0;border-radius:6px;cursor:pointer}@media(max-width:1100px){.tpa-stats{grid-template-columns:repeat(3,1fr)}.tpa-chart-grid{grid-template-columns:1fr}}@media(max-width:700px){.tpa-page{padding:12px}.tpa-heading{align-items:start;flex-direction:column}.tpa-filter{grid-template-columns:1fr 1fr}.tpa-stats{grid-template-columns:1fr 1fr}.tpa-chart-line{flex-wrap:wrap}}@media print{.tpa-filter,.tpa-actions,.tpa-backdrop{display:none!important}.tpa-page{padding:0;background:#fff}.tpa-panel{break-inside:avoid}}
