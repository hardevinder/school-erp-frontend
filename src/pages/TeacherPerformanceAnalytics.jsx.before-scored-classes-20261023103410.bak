import React, { useEffect, useMemo, useState } from 'react';
import api from '../api';
import { getExternalExamComparisons } from '../components/StudentExamComparison';
import './TeacherPerformanceAnalytics.css';

const PERIODS = ['PT-1','PT-2','HY'];
const COLORS = {'PT-1':'#3886ec','PT-2':'#24b48d','HY':'#fa9450'};
const list = (d,key) => Array.isArray(d)?d:Array.isArray(d?.[key])?d[key]:Array.isArray(d?.data)?d.data:Array.isArray(d?.data?.[key])?d.data[key]:[];
const label = (o, keys, fallback='—') => keys.map(k=>o?.[k]).find(v=>v!==null&&v!==undefined&&String(v).trim()) ?? fallback;
const num = v => v===null||v===undefined||v===''?null:Number.isFinite(Number(v))?Number(v):null;
const mean = xs => xs.length?xs.reduce((a,b)=>a+b,0)/xs.length:null;
const pct = v => Number.isFinite(v)?`${v.toFixed(1)}%`:'—';
const pp = v => Number.isFinite(v)?`${v>0?'+':''}${v.toFixed(1)} pp`:'—';
const teacherObj = a => a?.Teacher||a?.teacher||{};
const teacherId = a => String(a?.teacher_id??a?.teacherId??teacherObj(a).id??'');
const classId = a => String(a?.class_id??a?.classId??a?.Class?.id??'');
const sectionId = a => String(a?.section_id??a?.sectionId??a?.Section?.id??'');
const subjectId = a => String(a?.subject_id??a?.subjectId??a?.Subject?.id??'');
const subjectName = a => label(a?.Subject||a?.subject,['name','subject_name'],label(a,['subject_name'],'Subject'));
const photo = a => {const t=teacherObj(a);const e=t.employee||t.Employee||t.employeeProfile||{};let value=label(e,['photo_url','photo'],label(t,['profilePhoto','photo_url','photo'],''));if(!value)return '';value=String(value);if(/^(https?:|data:|blob:)/i.test(value))return value;const base=String(api.defaults?.baseURL||window.location.origin).replace(/\/api\/?$/,'').replace(/\/$/,'');const path=value.replace(/^\/+/, '');return `${base}/${path.startsWith('uploads/')?path:'uploads/'+path}`;};
const scoresFor = student => getExternalExamComparisons(student);
const subjectScore = (student,assignment) => scoresFor(student).find(s=>String(s.id)===subjectId(assignment)||String(s.name||'').toLowerCase()===String(subjectName(assignment)).toLowerCase());
const scoreChange = scores => {const found=PERIODS.filter(k=>Number.isFinite(scores?.[k]?.percent));return found.length>1?scores[found[found.length-1]].percent-scores[found[0]].percent:null;};
function Bars({scores}){const valid=PERIODS.filter(k=>Number.isFinite(scores?.[k]));return <div className="tpa-bars">{valid.map(k=><div className="tpa-bar" key={k}><strong>{pct(scores[k])}</strong><div className="tpa-track"><div style={{height:`${Math.min(100,Math.max(0,scores[k]))}%`,background:COLORS[k]}}/></div><small>{k}</small></div>)}{!valid.length&&<span>No entered marks</span>}</div>}
function Avatar({src,name}){const [bad,setBad]=useState(false);useEffect(()=>setBad(false),[src]);return src&&!bad?<img className="tpa-avatar" src={src} alt={`${name} profile`} onError={()=>setBad(true)}/>:<div className="tpa-avatar tpa-avatar-fallback">{String(name||'?').slice(0,1).toUpperCase()}</div>}
function getStudentPhoto(s){const raw=label(s,['photo_url','photoUrl','student_photo','studentPhoto','photo','profile_photo'],'');if(!raw)return '';if(/^(https?:|data:|blob:)/i.test(raw))return raw;const base=String(api.defaults?.baseURL||window.location.origin).replace(/\/api\/?$/,'').replace(/\/$/,'');let path=String(raw).replace(/^\/+/, '');if(!path.startsWith('uploads/'))path=path.includes('/')?`uploads/${path}`:`uploads/photoes/students/${path}`;return `${base}/${path}`;}
export default function TeacherPerformanceAnalytics(){
 const [sessions,setSessions]=useState([]),[classes,setClasses]=useState([]),[sections,setSections]=useState([]),[exams,setExams]=useState([]),[assignments,setAssignments]=useState([]);
 const [session,setSession]=useState(''),[teacher,setTeacher]=useState(''),[teacherSearch,setTeacherSearch]=useState(''),[examIds,setExamIds]=useState([]),[busy,setBusy]=useState(false),[err,setErr]=useState(''),[results,setResults]=useState([]),[search,setSearch]=useState(''),[selectedStudent,setSelectedStudent]=useState(null),[teacherModal,setTeacherModal]=useState(false);
 useEffect(()=>{let active=true;Promise.all([api.get('/sessions'),api.get('/report-card/scope'),api.get('/class-subject-teachers')]).then(([a,b,c])=>{if(!active)return;const ss=list(a.data,'sessions');setSessions(ss);setSession(String(ss.find(s=>s.is_active)?.id||ss[0]?.id||''));setClasses(list(b.data,'classes'));setSections(list(b.data,'sections'));setAssignments(list(c.data,'assignments'));}).catch(e=>{if(active)setErr(e?.response?.status===403?'Teacher assignment access denied. Please use an authorized admin account.':'Unable to load sessions, class scope or teacher assignments.')});return()=>{active=false}},[]);
 useEffect(()=>{if(!session)return;let active=true;api.get('/exams',{params:{session_id:Number(session)}}).then(r=>{if(active)setExams(list(r.data,'exams'))}).catch(()=>{if(active)setExams([])});return()=>{active=false}},[session]);
 const teachers=useMemo(()=>{const map=new Map();assignments.forEach(a=>{const id=teacherId(a);if(id&&!map.has(id))map.set(id,{id,name:label(teacherObj(a),['name','full_name','fullName'],label(a,['teacher_name'],'Teacher')),src:photo(a),assignments:[]});if(id)map.get(id).assignments.push(a)});return [...map.values()].sort((a,b)=>a.name.localeCompare(b.name))},[assignments]);
 const chosen=teachers.find(t=>t.id===teacher);
 const classLabel=id=>label(classes.find(c=>String(c.id)===String(id)),['name','class_name'],String(id));
 const sectionLabel=id=>label(sections.find(s=>String(s.id)===String(id)),['section_name','name'],String(id));
 const assignmentsForTeacher=chosen?.assignments||[];
 async function loadResults(targetTeacher=chosen){const selectedExams=examIds.length?examIds:exams.map(e=>Number(e.id)).filter(Number.isFinite);if(!session||!targetTeacher||!selectedExams.length){setErr('Select a teacher from the directory and at least one examination.');return}setBusy(true);setErr('');setResults([]);setSelectedStudent(null);try{
 const groups=new Map();for(const a of targetTeacher.assignments){const cid=classId(a),sid=sectionId(a);if(!cid||!sid||!subjectId(a))continue;const key=cid+'|'+sid;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(a)}
 if(!groups.size)throw Error('Selected teacher has no class-section-subject assignments.');
 const output=[];
 for(const [key,as] of groups){const [cid,sid]=key.split('|');const params={session_id:Number(session),class_id:Number(cid),section_id:Number(sid),exam_ids:selectedExams.map(Number),sum:true,showSubjectTotals:true,includeGrades:true};
 try{const sr=await api.get('/subjects',{params:{class_id:params.class_id,session_id:params.session_id}});const all=list(sr.data,'subjects');const ids=[...new Set(all.map(s=>num(s.id??s.subject_id??s.subjectId)).filter(x=>Number.isInteger(x)&&x>0))];if(!ids.length)throw Error('No subjects available for this class');params.subject_ids=ids;params.subjectComponents=ids.map(subject_id=>({subject_id}));const {data}=await api.post('/report-card/detailed-summary',params);let students=list(data,'students');
 try{const r=await api.get('/report-card/students',{params:{session_id:params.session_id,class_id:params.class_id,section_id:params.section_id,student_ids:students.map(s=>s.id)}});const profiles=new Map(list(r.data,'students').map(s=>[String(s.id),s]));students=students.map(s=>({...profiles.get(String(s.id)),...s,components:s.components||[]}))}catch(e){console.warn('Optional student profiles unavailable',e)}
 for(const a of as){const persons=students.map(s=>({student:s,score:subjectScore(s,a)})).filter(x=>x.score);const averages={};for(const k of PERIODS){const p=persons.map(x=>x.score?.scores?.[k]?.percent).filter(Number.isFinite);if(p.length)averages[k]=mean(p)}const records=persons.map(x=>({...x,change:scoreChange(x.score?.scores)}));output.push({key:key+'|'+subjectId(a),class_id:cid,section_id:sid,subject_id:subjectId(a),subject:subjectName(a),students:records,averages,change:scoreChange(Object.fromEntries(PERIODS.filter(k=>Number.isFinite(averages[k])).map(k=>[k,{percent:averages[k]}])))});}
 }catch(e){output.push({key:key+'|error',class_id:cid,section_id:sid,error:e?.response?.data?.message||e.message})}}
 setResults(output);if(output.every(x=>x.error))setErr('None of the assigned class reports could be loaded. Check permissions and selected exams.');
 }catch(e){setErr(e?.message||'Could not load teacher analytics.')}finally{setBusy(false)}}
 function openTeacher(t){setTeacher(t.id);setTeacherModal(true);setResults([]);setSelectedStudent(null);setErr('');loadResults(t);}
 useEffect(()=>{if(!teacherModal)return;const handler=e=>{if(e.key==='Escape'&&!selectedStudent)setTeacherModal(false)};window.addEventListener('keydown',handler);return()=>window.removeEventListener('keydown',handler)},[teacherModal,selectedStudent]);
 const valid=results.filter(x=>!x.error);const studentMap=new Map();valid.forEach(r=>r.students.forEach(x=>{const key=String(x.student.id);if(!studentMap.has(key))studentMap.set(key,{student:x.student,entries:[]});studentMap.get(key).entries.push({...x,subject:r.subject,class_id:r.class_id,section_id:r.section_id})}));
 const people=[...studentMap.values()].map(p=>{const scores={};for(const k of PERIODS){const values=p.entries.map(e=>e.score?.scores?.[k]?.percent).filter(Number.isFinite);if(values.length)scores[k]=mean(values)}return {...p,scores,change:scoreChange(Object.fromEntries(PERIODS.filter(k=>Number.isFinite(scores[k])).map(k=>[k,{percent:scores[k]}])))};});
 const allChanges=people.map(p=>p.change).filter(Number.isFinite),improved=allChanges.filter(x=>x>0).length,declined=allChanges.filter(x=>x<0).length;
 const subjects=[...new Set(valid.map(r=>r.subject))].map(name=>{const items=valid.filter(r=>r.subject===name),averages={};PERIODS.forEach(k=>{const data=items.flatMap(r=>r.students.map(x=>x.score?.scores?.[k]?.percent)).filter(Number.isFinite);if(data.length)averages[k]=mean(data)});return {name,averages}});
 const visible=people.filter(p=>`${p.student.name||''} ${p.student.roll_number||''}`.toLowerCase().includes(search.toLowerCase()));
 const ordered=[...people].filter(p=>Number.isFinite(p.scores.HY??p.scores['PT-2']??p.scores['PT-1'])).sort((a,b)=>(b.scores.HY??b.scores['PT-2']??b.scores['PT-1'])-(a.scores.HY??a.scores['PT-2']??a.scores['PT-1']));
 function studentTable(arr){return <div className="tpa-scroll"><table><thead><tr><th>Student</th><th>Classes / subjects</th>{PERIODS.map(k=><th key={k}>{k}</th>)}<th>Change</th></tr></thead><tbody>{arr.map(p=><tr key={p.student.id} onClick={()=>setSelectedStudent(p)} className="tpa-click"><td><div className="tpa-person"><Avatar src={getStudentPhoto(p.student)} name={p.student.name}/><span><b>{p.student.name}</b><small>Roll {p.student.roll_number||'—'}</small></span></div></td><td>{p.entries.map(e=>`${classLabel(e.class_id)}-${sectionLabel(e.section_id)} ${e.subject}`).join(', ')}</td>{PERIODS.map(k=><td key={k}>{pct(p.scores[k])}</td>)}<td className={p.change>0?'tpa-up':p.change<0?'tpa-down':''}>{pp(p.change)}</td></tr>)}</tbody></table></div>}
 return <main className="tpa-page"><header className="tpa-heading"><div><small>EXAMINATION · ACADEMIC INTELLIGENCE</small><h1>Teacher Performance Analytics</h1><p>Academic outcomes across assigned classes and subjects · External PT and HY marks only</p></div><div className="tpa-actions"><button disabled={!valid.length} onClick={()=>window.print()}>🖨 Print / Save PDF</button><button disabled={!valid.length} onClick={()=>{const lines=[['Teacher','Class','Section','Subject','Students','PT-1 Avg','PT-2 Avg','HY Avg','Change'],...valid.map(r=>[chosen?.name,classLabel(r.class_id),sectionLabel(r.section_id),r.subject,r.students.length,...PERIODS.map(k=>r.averages[k]?.toFixed(1)??''),r.change?.toFixed(1)??''])];const csv=lines.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n');const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='teacher-performance.csv';a.click();URL.revokeObjectURL(url)}}>⬇ Export CSV</button></div></header>
 <section className="tpa-filter"><label>Session<select value={session} onChange={e=>{setSession(e.target.value);setExamIds([]);setResults([])}}><option value="">Select session</option>{sessions.map(s=><option key={s.id} value={s.id}>{label(s,['name','session_name','academic_year'])}</option>)}</select></label><label>Examination(s)<select multiple size={Math.min(4,Math.max(2,exams.length))} value={examIds.map(String)} onChange={e=>{setExamIds(Array.from(e.target.selectedOptions).map(o=>Number(o.value)));setResults([])}}>{exams.map(e=><option key={e.id} value={e.id}>{label(e,['name','exam_name'])}</option>)}</select><small>Ctrl/⌘ to select multiple</small></label><span className="tpa-filter-hint">Select a teacher below to open their performance report instantly.</span></section>

 <section className="tpa-directory tpa-panel" aria-label="All assigned teachers">
 <div className="tpa-panel-head"><div><h2>Teacher Directory <span className="tpa-counter">{teachers.length}</span></h2><p>Choose a teacher to view their class-wise academic performance.</p></div><input aria-label="Search teachers" value={teacherSearch} onChange={e=>setTeacherSearch(e.target.value)} placeholder="Search teacher, subject or class…" /></div>
 <div className="tpa-directory-grid">{teachers.filter(t=>`${t.name} ${t.assignments.map(a=>`${subjectName(a)} ${classLabel(classId(a))}-${sectionLabel(sectionId(a))}`).join(' ')}`.toLowerCase().includes(teacherSearch.trim().toLowerCase())).map(t=>{
 const cls=new Set(t.assignments.map(a=>`${classId(a)}-${sectionId(a)}`));const subs=new Set(t.assignments.map(subjectId));const isChosen=t.id===teacher;
 return <button type="button" key={t.id} className={`tpa-teacher-card ${isChosen?'tpa-selected':''}`} aria-pressed={isChosen} onClick={()=>openTeacher(t)}>
 <Avatar src={t.src} name={t.name}/><span className="tpa-teacher-copy"><strong>{t.name}</strong><small>{cls.size} class-section{cls.size!==1?'s':''} · {subs.size} subject{subs.size!==1?'s':''}</small><em>{[...new Set(t.assignments.map(a=>subjectName(a)))].slice(0,3).join(' · ')}</em></span><span className="tpa-teacher-arrow">{isChosen?'✓':'→'}</span></button>})}</div>
 {!teachers.length&&<p className="tpa-directory-empty">No teacher assignments available for this account.</p>}
 </section>
 {teacherModal&&<div className="tpa-modal-backdrop" onMouseDown={e=>{if(e.target===e.currentTarget)setTeacherModal(false)}}><section className="tpa-modal" role="dialog" aria-modal="true" aria-label={`${chosen?.name||'Teacher'} performance report`}><div className="tpa-modal-toolbar"><div><span>SMCIS · ACADEMIC INTELLIGENCE</span><h2>{chosen?.name||'Teacher'} — Performance Report</h2></div><button type="button" onClick={()=>setTeacherModal(false)} aria-label="Close teacher report">✕ Close</button></div><div className="tpa-modal-content">
 {err&&<div className="tpa-alert" role="alert">{err}</div>}{results.some(x=>x.error)&&<div className="tpa-note">Some assigned classes could not be loaded: {results.filter(x=>x.error).map(x=>`${classLabel(x.class_id)}-${sectionLabel(x.section_id)}`).join(', ')}. These are excluded from the totals.</div>}
 {chosen&&<section className="tpa-profile"><Avatar src={chosen.src} name={chosen.name}/><div><h2>{chosen.name}</h2><p>{assignmentsForTeacher.length} assigned subject–class combinations</p><small>{assignmentsForTeacher.map(a=>`${classLabel(classId(a))}-${sectionLabel(sectionId(a))} ${subjectName(a)}`).join(' · ')}</small></div></section>}
 {!valid.length?<div className="tpa-empty">{busy?'Loading assigned classes and student results…':err?'Please check the message above.':'No marks found for the selected teacher/examinations.'}</div>:<><section className="tpa-stats">{[['Total students',people.length],['Assigned subjects',subjects.length],['Classes assigned',new Set(valid.map(r=>r.class_id+'|'+r.section_id)).size],['Average change',pp(mean(allChanges))],['Students improved',improved],['Students declined',declined]].map(([name,value])=><article key={name}><small>{name}</small><strong>{value}</strong></article>)}</section>
 <section className="tpa-panel tpa-class-graph"><div className="tpa-panel-head"><h2>Class-wise average performance</h2><small>PT-1 · PT-2 · HY — external marks</small></div><div className="tpa-class-graph-grid">{valid.map(r=><div className="tpa-chart-line" key={r.key}><div><b>{classLabel(r.class_id)}-{sectionLabel(r.section_id)}</b><small>{r.subject}</small></div><Bars scores={r.averages}/></div>)}</div></section><section className="tpa-panel tpa-subject-graph"><h2>Subject-wise performance</h2><div className="tpa-subject-grid">{subjects.map(s=><div className="tpa-chart-line" key={s.name}><b>{s.name}</b><Bars scores={s.averages}/></div>)}</div></section>
 <div className="tpa-chart-grid"><section className="tpa-panel"><h2>Top performing students</h2>{studentTable(ordered.slice(0,5))}</section><section className="tpa-panel"><h2>Students requiring academic support</h2>{studentTable([...people].filter(p=>Number.isFinite(p.change)).sort((a,b)=>a.change-b.change).slice(0,5))}</section></div>
 <section className="tpa-panel"><div className="tpa-panel-head"><h2>All assigned students</h2><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search student" aria-label="Search students"/></div>{studentTable(visible)}</section>
 <section className="tpa-panel"><h2>Assigned subjects & class details</h2><div className="tpa-scroll"><table><thead><tr><th>Class</th><th>Subject</th><th>Students assessed</th>{PERIODS.map(k=><th key={k}>{k} avg</th>)}<th>Change</th></tr></thead><tbody>{valid.map(r=><tr key={r.key}><td>{classLabel(r.class_id)} - {sectionLabel(r.section_id)}</td><td>{r.subject}</td><td>{r.students.length}</td>{PERIODS.map(k=><td key={k}>{pct(r.averages[k])}</td>)}<td>{pp(r.change)}</td></tr>)}</tbody></table></div></section><p className="tpa-note">Scores summarize student results in the selected assigned classes; they are not teacher effectiveness ratings. Comparisons use percentages and only entered external assessments. One student is counted once in the summary.</p></>}
 </div></section></div>}
 {selectedStudent&&<div className="tpa-backdrop" onClick={e=>{if(e.target===e.currentTarget)setSelectedStudent(null)}}><section className="tpa-dialog" role="dialog" aria-modal="true" aria-label="Student performance"><button onClick={()=>setSelectedStudent(null)}>✕ Close</button><div className="tpa-person"><Avatar src={getStudentPhoto(selectedStudent.student)} name={selectedStudent.student.name}/><h2>{selectedStudent.student.name}</h2></div>{selectedStudent.entries.map((e,i)=><div className="tpa-chart-line" key={i}><b>{classLabel(e.class_id)}-{sectionLabel(e.section_id)} · {e.subject}</b><Bars scores={Object.fromEntries(PERIODS.filter(k=>Number.isFinite(e.score?.scores?.[k]?.percent)).map(k=>[k,e.score.scores[k].percent]))}/></div>)}</section></div>}
 </main>;
}
