  { Name: "Working Together", Abbreviation: "WTG", Type: "GRADE", "Max Marks": "", "Assessment Nature": "INTERNAL", "Academic Category": "Scholastic", Practical: "No", Active: "Yes" },
  { Name: "Self Feeding", Abbreviation: "SFD", Type: "GRADE", "Max Marks": "", "Assessment Nature": "INTERNAL", "Academic Category": "Scholastic", Practical: "No", Active: "Yes" },
  { Name: "Personal Development", Abbreviation: "PDEV", Type: "GRADE", "Max Marks": "", "Assessment Nature": "INTERNAL", "Academic Category": "Scholastic", Practical: "No", Active: "Yes" },
  { Name: "Independent Work", Abbreviation: "INW", Type: "GRADE", "Max Marks": "", "Assessment Nature": "INTERNAL", "Academic Category": "Scholastic", Practical: "No", Active: "Yes" },
  { Name: "Cleanliness and Hygiene", Abbreviation: "CLH", Type: "GRADE", "Max Marks": "", "Assessment Nature": "INTERNAL", "Academic Category": "Scholastic", Practical: "No", Active: "Yes" },
