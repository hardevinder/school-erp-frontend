.spa-page{padding:24px;min-height:100vh;background:#f6f9fe;color:#15294a;font-family:inherit}.spa-heading{margin-bottom:22px}.spa-eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:2px;color:#2874d4;font-weight:800}.spa-heading h1{font-size:30px;letter-spacing:-.8px;font-weight:800;margin:5px 0}.spa-heading p,.spa-directory-heading p{color:#74839b;margin:4px 0}.spa-filter-card{background:#fff;border:1px solid #e4eaf5;border-radius:18px;padding:20px;box-shadow:0 8px 30px #172d5710;margin-bottom:24px}.spa-filter-grid{display:grid;grid-template-columns:1fr 1fr 1fr 1.5fr auto;gap:14px;align-items:end}.spa-filter-grid label{display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:700}.spa-filter-grid select,.spa-directory-heading input{width:100%;background:#f8fbff;border:1px solid #d5deeb;border-radius:10px;padding:10px 12px;color:#15294a;outline-color:#377ff5}.spa-filter-grid small{font-size:11px;color:#8490a2;font-weight:400}.spa-load{background:#124b85;border:0;border-radius:10px;padding:12px 18px;color:white;font-weight:700;cursor:pointer}.spa-load:disabled{opacity:.55}.spa-error{margin-top:14px;color:#a72837;background:#fff1f3;padding:12px;border-radius:9px}.spa-directory-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 0 16px}.spa-directory-heading h2{margin:0;font-size:20px;font-weight:800}.spa-directory-heading h2 span{font-size:14px;color:#488af3;background:#e5efff;padding:4px 9px;border-radius:20px}.spa-directory-heading input{max-width:350px}.spa-directory{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.spa-student-card{min-width:0;display:flex;align-items:center;gap:12px;padding:14px;text-align:left;background:#fff;border:1px solid #e0e8f5;border-radius:16px;cursor:pointer;box-shadow:0 3px 15px #2a41630a;color:inherit;transition:transform .15s,box-shadow .15s}.spa-student-card:hover{transform:translateY(-2px);box-shadow:0 10px 25px #234b7f1a;border-color:#95baff}.spa-portrait{width:62px;height:70px;flex:none;object-fit:cover;border-radius:12px;background:#eaf1fb}.spa-portrait-empty{display:grid;place-items:center;color:#9babc1;font-size:25px}.spa-portrait-lg{width:112px;height:122px}.spa-student-info{display:flex;flex-direction:column;gap:5px;min-width:0;flex:1}.spa-student-info strong{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:14px}.spa-student-info span,.spa-student-info small{font-size:11px;color:#697b94}.spa-chip{padding:6px 8px;border-radius:8px;background:#edf3fd;color:#3469ae;font-size:12px;font-weight:800;white-space:nowrap}.spa-chip.up,.spa-delta.up,.spa-table .up{color:#09855d;background:#e5f8ef}.spa-chip.down,.spa-delta.down,.spa-table .down{color:#c32b43;background:#fff0f1}.spa-arrow{color:#8a9db8;font-size:23px}.spa-empty{text-align:center;padding:48px 20px;background:#fff;border:1px dashed #cadaef;border-radius:16px;color:#7f8ca1;grid-column:1/-1}.spa-overlay{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;background:#12213bc9;padding:26px}.spa-dialog{position:relative;max-width:1500px;width:100%;max-height:94vh;overflow-y:auto;background:white;border-radius:22px;box-shadow:0 30px 100px #0005}.spa-close{position:sticky;float:right;top:12px;margin:10px 12px -45px 0;z-index:3;background:#edf3ff;border:0;border-radius:50%;font-size:18px;width:37px;height:37px;cursor:pointer;color:#1a3e70}.spa-student-header{display:flex;align-items:center;gap:25px;padding:26px 28px;background:linear-gradient(120deg,#f8fbff,#eaf2ff);border-bottom:1px solid #e0e9f8}.spa-student-text{flex:1;min-width:180px}.spa-student-text h2{font-size:29px;font-weight:800;margin:0 0 7px}.spa-student-text p{margin:4px 0;color:#40546e;font-size:14px}.spa-metrics{display:flex;gap:14px}.spa-metric{min-width:155px;min-height:100px;display:flex;flex-direction:column;justify-content:center;gap:10px;text-align:center;border-radius:12px;padding:15px}.spa-metric span{font-size:13px;font-weight:700}.spa-metric strong{font-size:30px}.spa-blue{background:#e9f2ff;color:#1e60c1}.spa-green{background:#e7f7ef;color:#078359}.spa-red{background:#fff0f1;color:#c31e39}.spa-body{padding:25px}.spa-detail-title{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.spa-detail-title h2{font-size:21px;font-weight:800}.spa-detail-title small{font-size:13px;color:#68809e}.spa-legend{display:flex;gap:14px;flex-wrap:wrap}.spa-legend span{font-size:12px;display:flex;align-items:center;gap:6px}.spa-legend i{width:13px;height:13px;border-radius:3px}.spa-hint{color:#7d8aa1;font-size:12px;margin:5px 0 18px}.spa-subject-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.spa-subject-card{border:1px solid #dce4ef;border-radius:12px;padding:16px;min-width:0;background:linear-gradient(#fff,#fbfdff)}.spa-subject-card h3{text-align:center;font-size:14px;font-weight:800;margin:0 0 10px}.spa-chart{display:flex;align-items:stretch;gap:10px;height:187px;border-bottom:1px solid #dae4f1}.spa-bar-col{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;justify-content:flex-end}.spa-mark-label{font-size:10px;white-space:nowrap}.spa-bar-track{height:125px;width:100%;display:flex;align-items:flex-end;justify-content:center}.spa-bar{width:min(50px,70%);border-radius:5px 5px 0 0;transition:height .2s}.spa-bar-name{font-size:11px;margin-top:7px}.spa-bar-col strong{font-size:12px}.spa-delta{font-size:12px;text-align:center;font-weight:800;margin:13px 0 0}.spa-delta.neutral{color:#6a7b93}.spa-table-wrap{overflow-x:auto;margin-top:21px}.spa-table{width:100%;border-collapse:collapse;font-size:12px}.spa-table th,.spa-table td{border:1px solid #dde6f3;padding:9px 12px;text-align:center;white-space:nowrap}.spa-table th:first-child{text-align:left}.spa-table thead{background:#eaf2ff;color:#203f6b}.spa-table tbody tr:nth-child(even){background:#f8fbff}@media(max-width:1300px){.spa-directory{grid-template-columns:repeat(2,minmax(0,1fr))}.spa-subject-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.spa-metrics{flex-wrap:wrap}.spa-metric{min-width:115px}}@media(max-width:850px){.spa-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.spa-subject-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.spa-student-header{flex-wrap:wrap}.spa-metrics{width:100%}.spa-metric{flex:1}.spa-overlay{padding:8px}.spa-body{padding:15px}}@media(max-width:550px){.spa-page{padding:12px}.spa-filter-grid,.spa-directory{grid-template-columns:1fr}.spa-directory-heading{flex-wrap:wrap}.spa-directory-heading input{max-width:none}.spa-subject-grid{grid-template-columns:1fr}.spa-metrics{gap:6px}.spa-metric{min-width:80px;padding:8px}.spa-metric strong{font-size:20px}.spa-student-header{padding:14px}.spa-student-text h2{font-size:21px}}

/* Student PDF toolbar visibility fix */
.spa-pdf-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 70px 14px 22px;position:relative;z-index:2;background:#ffffff;border-bottom:1px solid #e2eaf5;min-height:62px;box-sizing:border-box}
.spa-pdf-toolbar-title{font-weight:800;color:#183b69;font-size:15px}.spa-pdf-toolbar-title small{font-size:12px;font-weight:500;color:#7487a2}
.spa-pdf-download{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:#12528c!important;color:#fff!important;border:none;border-radius:9px;padding:11px 16px;min-height:42px;font-weight:800;white-space:nowrap;cursor:pointer;box-shadow:0 3px 10px #12528c24}.spa-pdf-download:hover{background:#0b3f70!important}.spa-pdf-download:focus-visible{outline:3px solid #76a7ed;outline-offset:2px}
@media(max-width:600px){.spa-pdf-toolbar{padding:12px 56px 12px 12px;gap:8px;flex-wrap:wrap}.spa-pdf-toolbar-title{font-size:13px}.spa-pdf-download{font-size:12px;padding:9px 11px;white-space:normal}}
